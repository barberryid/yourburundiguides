---
import { priceCards } from '../data/prices';
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const displayCards = preview ? priceCards : priceCards;
---

<section id="prices" class="py-16 md:py-24 bg-[var(--color-brand-cream)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Prices and quotes"
      subtitle="Prices depend on the route, number of people, transport needs and length of the trip. Contact Gabriel on WhatsApp for a clear quote before you travel."
    />

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {displayCards.map((card) => (
        <article class="card flex flex-col border border-[var(--color-brand-green)]/10">
          <h3 class="mb-3 text-xl font-bold text-[var(--color-brand-green-dark)]">{card.title}</h3>
          <p class="mb-4 text-base leading-8 text-[var(--color-brand-muted)]">{card.bestFor}</p>
          <div class="mb-5 rounded-xl bg-[var(--color-brand-green-soft)] p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-[var(--color-brand-green-dark)]">Quote required:</p>
            <p class="mt-1 text-base leading-7 text-[var(--color-brand-muted)]">{card.note}</p>
          </div>
          <p class="mb-2 text-base font-bold leading-7 text-[var(--color-brand-green-dark)]">
            {card.title === 'Custom Burundi trip' ? 'Useful for:' : 'Includes:'}
          </p>
          <ul class="mb-6 flex-grow space-y-2">
            {card.includes.map((item) => (
              <li class="flex items-start gap-2 text-base leading-7 text-[var(--color-brand-charcoal)]">
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-[var(--color-brand-green)]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a
            href={site.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp justify-center text-sm"
          >
            {card.cta}
          </a>
        </article>
      ))}
    </div>

    {preview && (
      <div class="text-center mt-10">
        <a href="/prices/" class="btn-green">
          View full pricing details
        </a>
      </div>
    )}
  </div>
</section>
