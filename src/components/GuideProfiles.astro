---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';

const guides = [site.guides.gabriel, site.guides.ernest];
---

<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Meet Your Guides"
      subtitle="Gabriel and Ernest are local guides based in Bujumbura. They have helped travellers from across the world explore Burundi."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {guides.map((guide) => (
        <div class="card flex flex-col items-center text-center sm:items-start sm:text-left sm:flex-row gap-6">
          <div class="flex-shrink-0">
            <div class="w-24 h-24 rounded-full overflow-hidden bg-[var(--color-brand-bg-light)] border-4 border-[var(--color-brand-green)]/20">
              <img
                src={guide.image}
                alt={guide.alt}
                class="w-full h-full object-cover"
                loading="lazy"
                onerror="this.style.display='none';this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-4xl bg-[var(--color-brand-bg-light)]\'>👤</div>'"
              />
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[var(--color-brand-green-dark)] mb-1">{guide.name}</h3>
            <p class="text-[var(--color-brand-gold)] text-sm font-semibold mb-3">{guide.role}</p>
            <p class="text-[var(--color-brand-muted)] text-sm leading-relaxed">{guide.bio}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
