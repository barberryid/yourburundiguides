---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';

const guides = [
  {
    ...site.guides.gabriel,
    goodFor: [
      'Trip planning before arrival',
      'Private guiding in Bujumbura and beyond',
      'Airport pickup and arrival support',
      'Translation between English, French and Kirundi',
      'Realistic local advice about what is possible',
    ],
  },
  {
    ...site.guides.ernest,
    goodFor: [
      'Airport pickups',
      'Private day trips',
      'Transport around Burundi',
      'Practical support on the road',
      'Local guidance during visits',
    ],
  },
];
---

<section id="guides" class="py-16 md:py-24 bg-[var(--color-brand-cream)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Meet your Burundi guides"
      subtitle="Gabriel and Ernest are local guides based in Bujumbura. They help independent travellers, small groups and visitors who want practical local support in Burundi."
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {guides.map((guide) => (
        <article class="card grid gap-5 sm:grid-cols-[8rem_1fr]">
          <img
            src={guide.image}
            alt={guide.alt}
            class="h-32 w-32 rounded-xl object-cover"
            loading="lazy"
            decoding="async"
            width="320"
            height="320"
          />
          <div>
            <h3 class="text-xl font-bold text-[var(--color-brand-green-dark)]">{guide.name}</h3>
            <p class="mb-3 text-base font-semibold leading-7 text-[var(--color-brand-gold)]">{guide.role}</p>
            <p class="mb-4 text-base leading-8 text-[var(--color-brand-muted)]">{guide.bio}</p>
            <p class="mb-2 text-base font-bold leading-7 text-[var(--color-brand-green-dark)]">Good for:</p>
            <ul class="space-y-2">
              {guide.goodFor.map((item) => (
                <li class="flex gap-2 text-base leading-7 text-[var(--color-brand-charcoal)]">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-brand-green)]"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
