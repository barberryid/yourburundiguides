---
import { faqs } from '../data/faqs';
import SectionHeading from './SectionHeading.astro';

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const displayFaqs = preview ? faqs.slice(0, 5) : faqs;
---

<section id="faq" class="py-16 md:py-24 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Common questions"
      subtitle="Things travellers often ask before visiting Burundi."
    />

    <div class="space-y-4" data-accordion>
      {displayFaqs.map((faq, i) => (
        <article class="card border border-gray-100">
          <h3 class="text-base">
            <button
              type="button"
              class="flex w-full items-center justify-between gap-4 text-left font-semibold text-[var(--color-brand-green-dark)]"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`faq-panel-${i}`}
              id={`faq-button-${i}`}
            >
              <span>{faq.question}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-[var(--color-brand-green)] transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </h3>
          <div
            id={`faq-panel-${i}`}
            role="region"
            aria-labelledby={`faq-button-${i}`}
            class={`mt-3 text-sm leading-relaxed text-[var(--color-brand-muted)] ${i === 0 ? '' : 'hidden'}`}
          >
            <p>{faq.answer}</p>
          </div>
        </article>
      ))}
    </div>

    {preview && (
      <div class="text-center mt-8">
        <a href="/contact/" class="btn-green">
          Ask Gabriel directly on WhatsApp
        </a>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll('[data-accordion]').forEach((accordion) => {
    accordion.querySelectorAll('button[aria-controls]').forEach((button) => {
      button.addEventListener('click', () => {
        const panel = document.getElementById(button.getAttribute('aria-controls') || '');
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        panel?.classList.toggle('hidden', expanded);
        button.querySelector('svg')?.classList.toggle('rotate-180', !expanded);
      });
    });
  });
</script>
