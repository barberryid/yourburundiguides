---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, centered = true, light = false } = Astro.props;
---

<div class={`mb-10 max-w-3xl ${centered ? 'mx-auto text-center' : ''}`}>
  <h2 class={`display-title text-balance text-4xl md:text-5xl mb-4 ${light ? 'text-white' : 'text-[var(--color-brand-green-dark)]'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`text-lg leading-8 ${light ? 'text-white/75' : 'text-[var(--color-brand-muted)]'} ${centered ? 'mx-auto' : ''}`}>
      {subtitle}
    </p>
  )}
</div>
