---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
  light?: boolean;
}

const { title, subtitle, centered = true, light = false } = Astro.props;
---

<div class={`mb-10 ${centered ? 'text-center' : ''}`}>
  <h2 class={`text-3xl sm:text-4xl font-bold mb-3 ${light ? 'text-white' : 'text-[var(--color-brand-green-dark)]'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`text-lg ${light ? 'text-white/75' : 'text-[var(--color-brand-muted)]'} max-w-2xl ${centered ? 'mx-auto' : ''}`}>
      {subtitle}
    </p>
  )}
</div>
