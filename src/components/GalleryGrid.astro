---
import { galleryImages } from '../data/gallery';

interface Props {
  preview?: boolean;
  limit?: number;
}

const { preview = false, limit = 12 } = Astro.props;
const images = galleryImages.slice(0, limit);
---

<div class="columns-2 sm:columns-3 lg:columns-4 gap-3 space-y-3">
  {images.map((img) => (
    <div class="break-inside-avoid overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-shadow">
      <img
        src={img.src}
        alt={img.alt}
        class="w-full h-auto object-cover block hover:scale-105 transition-transform duration-300"
        loading="lazy"
        onerror="this.parentElement.style.display='none'"
      />
    </div>
  ))}
</div>

{preview && (
  <div class="text-center mt-10">
    <a href="/photos/" class="btn-green">
      See all photos
    </a>
  </div>
)}
