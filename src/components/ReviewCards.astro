---
import { reviews } from '../data/reviews';
import SectionHeading from './SectionHeading.astro';

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const displayReviews = preview ? reviews.slice(0, 3) : reviews;
---

<section id="reviews" class="py-16 md:py-24 bg-[var(--color-brand-bg-light)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="What visitors say"
      subtitle="Experiences from travellers who visited Burundi with Gabriel and Ernest."
    />

    <p class="mx-auto mb-8 max-w-3xl text-center text-base leading-8 text-[var(--color-brand-muted)]">
      Travellers have used Gabriel and Ernest for airport pickup, private transport, day trips, translation and practical support in Burundi.
    </p>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {displayReviews.map((review) => (
        <article class="card flex flex-col">
          <div class="mb-4 flex gap-1" aria-label="5 stars">
            {Array.from({length: 5}).map(() => (
              <svg class="h-4 w-4 text-[var(--color-brand-gold)]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <blockquote class="mb-5 flex-grow text-base leading-8 text-[var(--color-brand-charcoal)]">
            "{review.text}"
          </blockquote>

          <div class="flex items-center gap-3 border-t border-gray-100 pt-4">
            {review.image ? (
              <img
                src={review.image}
                alt={review.alt}
                class="h-10 w-10 flex-shrink-0 rounded-full object-cover"
                loading="lazy"
                decoding="async"
                width="160"
                height="160"
              />
            ) : (
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-brand-green)]/10 text-sm font-bold text-[var(--color-brand-green)]">
                {review.name.charAt(0)}
              </div>
            )}
            <div>
              <p class="text-sm font-semibold text-[var(--color-brand-green-dark)]">{review.name}</p>
              <p class="text-xs text-[var(--color-brand-muted)]">{review.country}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    {preview && (
      <div class="text-center mt-10">
        <a href="/reviews/" class="btn-green">
          Read more reviews
        </a>
      </div>
    )}
  </div>
</section>
