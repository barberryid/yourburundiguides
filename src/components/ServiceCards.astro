---
import { services } from '../data/services';
import SectionHeading from './SectionHeading.astro';

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const displayServices = preview ? services.slice(0, 4) : services;
---

<section class="py-16 bg-[var(--color-brand-bg-light)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="What We Can Help With"
      subtitle="Practical support before and during your Burundi trip."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {displayServices.map((service) => (
        <div class="card hover:shadow-lg transition-shadow">
          <div class="text-3xl mb-3">{service.icon}</div>
          <h3 class="font-bold text-[var(--color-brand-green-dark)] mb-2">{service.title}</h3>
          <p class="text-[var(--color-brand-muted)] text-sm leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>

    {preview && (
      <div class="text-center mt-10">
        <a href="/services/" class="btn-green">
          View all services
        </a>
      </div>
    )}
  </div>
</section>
