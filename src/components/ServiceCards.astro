---
import { services } from '../data/services';
import SectionHeading from './SectionHeading.astro';

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const displayServices = preview ? services.slice(0, 4) : services;
---

<section id="services" class="py-16 md:py-24 bg-[var(--color-brand-bg-light)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="What we can help with"
      subtitle="Practical support before and during your Burundi trip."
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {displayServices.map((service) => (
        <article class="card flex h-full flex-col">
          <h3 class="mb-3 text-lg font-bold text-[var(--color-brand-green-dark)]">{service.title}</h3>
          <p class="mb-5 text-sm leading-relaxed text-[var(--color-brand-muted)]">{service.description}</p>
          {service.bestFor && (
            <div class="mt-auto">
              <p class="mb-2 text-sm font-bold text-[var(--color-brand-green-dark)]">Best for:</p>
              <ul class="space-y-2">
                {service.bestFor.map((item) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-[var(--color-brand-charcoal)]">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--color-brand-gold)]"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))}
    </div>

    {preview && (
      <div class="text-center mt-10">
        <a href="/services/" class="btn-green">
          View all services
        </a>
      </div>
    )}
  </div>
</section>
