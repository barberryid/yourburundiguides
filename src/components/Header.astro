---
import { site } from '../data/site';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/prices/', label: 'Prices' },
  { href: '/visa/', label: 'Visa' },
  { href: '/photos/', label: 'Photos' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/things-to-do/', label: 'Things to Do' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-[var(--color-brand-green-dark)] text-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex min-w-0 items-center gap-3 font-serif text-xl font-extrabold hover:opacity-90">
        <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-brand-gold)] text-xs font-black text-[var(--color-brand-green-dark)]">YBG</span>
        <span class="truncate">Your Burundi Guides</span>
      </a>

      <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`rounded px-3 py-2 text-sm font-bold transition-colors hover:bg-white/10 ${
              currentPath === link.href || currentPath === link.href.replace(/\/$/, '')
                ? 'bg-white/20 text-white'
                : 'text-white/85'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={site.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden min-h-11 items-center gap-2 rounded-full bg-[#168a42] px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-[#0f6d32] sm:flex"
        >
          WhatsApp Gabriel
        </a>

        <button
          id="mobile-menu-toggle"
          class="rounded p-2 text-white/90 transition-colors hover:bg-white/10 hover:text-white lg:hidden"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-[var(--color-brand-green-dark)] lg:hidden"
    aria-label="Mobile navigation"
  >
    <div class="space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block rounded px-3 py-2.5 text-sm font-bold transition-colors hover:bg-white/10 ${
            currentPath === link.href ? 'bg-white/20 text-white' : 'text-white/85'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href={site.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 flex min-h-12 w-full items-center justify-center rounded-full bg-[#168a42] px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-[#0f6d32]"
      >
        WhatsApp Gabriel
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
