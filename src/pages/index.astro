---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GuideProfiles from '../components/GuideProfiles.astro';
import ServiceCards from '../components/ServiceCards.astro';
import PriceCards from '../components/PriceCards.astro';
import ReviewCards from '../components/ReviewCards.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import FAQ from '../components/FAQ.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, pageMeta } from '../data/site';

const trustItems = [
  'Local guides based in Bujumbura',
  'English, French and Kirundi spoken',
  'Airport pickup available',
  'Clear quote before you travel',
  'Flexible private trips',
  'Visitors from 20+ countries',
];

const jumpLinks = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#guides', label: 'Guides' },
  { href: '#services', label: 'Services' },
  { href: '#trips', label: 'Trips' },
  { href: '#prices', label: 'Prices' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#faq', label: 'FAQ' },
  { href: '#contact', label: 'Contact' },
];

const steps = [
  {
    title: '1. Send your dates on WhatsApp',
    body: 'Tell Gabriel your travel dates, group size, interests and what kind of help you need.',
  },
  {
    title: '2. Get a realistic local suggestion',
    body: 'Gabriel explains what is possible, what is practical, and what transport may cost.',
  },
  {
    title: '3. Agree the plan and price',
    body: 'Confirm the itinerary and quote before you commit.',
  },
  {
    title: '4. Meet in Burundi',
    body: 'Gabriel or Ernest can help with pickup, guiding, transport, translation and local arrangements.',
  },
];

const localGuideReasons = [
  ['Local knowledge', 'Gabriel and Ernest know Bujumbura and the surrounding regions from the inside.'],
  ['Practical confidence', 'Ask real questions before and during your trip, and get realistic answers.'],
  ['Language support', 'Kirundi, French and English support can make daily travel much easier.'],
  ['Honest guidance', 'The guides will tell you what is accessible, what is not, and what to expect.'],
  ['Transport sorted', 'Private transport saves time and reduces uncertainty.'],
  ['Pre-trip planning', 'Get help shaping a realistic itinerary before you arrive.'],
];

const trips = [
  {
    place: 'Lake Tanganyika',
    desc: "One of the world's deepest lakes, right on Bujumbura's doorstep. Good for swimming, sunsets and relaxed lakeside stops.",
    bestFor: 'Lake views, swimming, sunsets, easy time near Bujumbura',
    usually: 'Half-day or relaxed local visit',
    cta: 'Ask about Lake Tanganyika',
  },
  {
    place: 'Gishora Drum Sanctuary',
    desc: "Traditional Burundian royal drum performances and one of Burundi's strongest cultural experiences.",
    bestFor: 'Culture, history, photography, traditional performance',
    usually: 'Full-day cultural trip from Bujumbura',
    cta: 'Ask about Gishora',
  },
  {
    place: 'Rusizi National Park',
    desc: 'Wetlands, hippos, crocodiles and birds close to Bujumbura.',
    bestFor: 'Wildlife, birds, short nature visits',
    usually: 'Half-day or short guided visit',
    cta: 'Ask about Rusizi',
  },
  {
    place: 'Burundi Highlands',
    desc: 'Rolling green hills, tea plantations and rural villages away from the city.',
    bestFor: 'Scenery, photography, rural landscapes',
    usually: 'Full-day or custom route',
    cta: 'Ask about the highlands',
  },
  {
    place: 'Source of the Nile Area',
    desc: 'A significant and rarely visited landmark connected to the southernmost source of the Nile River.',
    bestFor: 'Geography, unusual landmarks, overland travellers',
    usually: 'Custom day trip',
    cta: 'Ask about Source of the Nile',
  },
  {
    place: 'Local Markets',
    desc: 'Busy Bujumbura markets with fresh produce, crafts and local life.',
    bestFor: 'Local culture, daily life, photography, shopping',
    usually: 'Short guided city visit',
    cta: 'Ask about local markets',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TravelAgency',
    name: 'Your Burundi Guides',
    description: pageMeta.home.description,
    url: site.siteUrl,
    telephone: site.whatsapp,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Bujumbura',
      addressCountry: 'BI',
    },
    areaServed: {
      '@type': 'Country',
      name: 'Burundi',
    },
    availableLanguage: ['English', 'French', 'Kirundi'],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      telephone: site.whatsapp,
      email: site.email,
      availableLanguage: ['English', 'French', 'Kirundi'],
    },
    priceRange: '$$',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.siteUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      ['Can I book a private guide in Burundi?', 'Yes. Send your dates, number of people, interests and transport needs by WhatsApp so Gabriel can suggest a plan and a clear quote before you commit.'],
      ['Can you help with transport in Burundi?', 'The guides can arrange private transport for airport pickup, day trips and travel between destinations. Clear prices are agreed before you travel.'],
      ['Can you help with airport pickup in Bujumbura?', 'Yes. Gabriel or Ernest can meet you at Bujumbura International Airport. Confirm your arrival date, flight time and group size in advance.'],
      ['Do you offer fixed tours or custom trips?', 'Trips are flexible and adjusted around your interests, available time and travel needs. Gabriel will suggest a realistic plan based on your dates.'],
      ['Can you help with Burundi visa questions?', 'Gabriel can share practical arrival information, but visa rules can change. Always check the latest official requirements before you travel.'],
    ].map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: {
        '@type': 'Answer',
        text,
      },
    })),
  },
];
---

<BaseLayout
  title={pageMeta.home.title}
  description={pageMeta.home.description}
  canonical="https://www.yourburundiguides.com/"
  structuredData={structuredData}
>
  <Hero />

  <section aria-label="Trust signals" class="bg-[var(--color-brand-cream)] pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-stone-200 bg-[var(--color-brand-bg-light)] p-4 shadow-sm">
        <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
          {trustItems.map((item) => (
            <div class="rounded-xl bg-white px-3 py-3 text-sm font-semibold leading-snug text-[var(--color-brand-green-dark)]">
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <nav aria-label="Homepage section links" class="bg-[var(--color-brand-cream)] pb-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="mr-1 font-bold text-[var(--color-brand-green-dark)]">Jump to:</span>
        {jumpLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full border border-stone-300 bg-white px-3 py-2 font-semibold text-[var(--color-brand-green-dark)] transition-colors hover:border-[var(--color-brand-green)] hover:bg-[var(--color-brand-bg-light)]"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <section id="how-it-works" class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="How booking works"
        subtitle="A simple way to arrange local guiding, transport and practical help before you arrive in Burundi."
      />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
          <article class="card">
            <h3 class="mb-3 text-lg font-bold text-[var(--color-brand-green-dark)]">{step.title}</h3>
            <p class="text-sm leading-relaxed text-[var(--color-brand-muted)]">{step.body}</p>
          </article>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href={site.whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
          Ask Gabriel what is possible
        </a>
      </div>
    </div>
  </section>

  <GuideProfiles />
  <ServiceCards preview={true} />

  <section id="why-local-guide" class="py-16 md:py-24 bg-[var(--color-brand-green-dark)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Why travel with a local Burundi guide?"
        subtitle="Burundi is not a destination you find on every travel blog. A trusted local guide can make the trip easier, clearer and more flexible."
        light={true}
      />
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {localGuideReasons.map(([title, body]) => (
          <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <h3 class="mb-2 font-bold text-[var(--color-brand-gold)]">{title}</h3>
            <p class="text-sm leading-relaxed text-white/75">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="trips" class="py-16 md:py-24 bg-[var(--color-brand-bg-light)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Popular Burundi trips"
        subtitle="Some of the most popular places to visit in Burundi with a local guide."
      />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {trips.map((trip) => (
          <article class="card flex flex-col">
            <h3 class="mb-3 text-xl font-bold text-[var(--color-brand-green-dark)]">{trip.place}</h3>
            <p class="mb-5 text-sm leading-relaxed text-[var(--color-brand-muted)]">{trip.desc}</p>
            <dl class="mb-6 grid gap-4 text-sm">
              <div>
                <dt class="font-bold text-[var(--color-brand-green-dark)]">Best for:</dt>
                <dd class="text-[var(--color-brand-muted)]">{trip.bestFor}</dd>
              </div>
              <div>
                <dt class="font-bold text-[var(--color-brand-green-dark)]">Usually:</dt>
                <dd class="text-[var(--color-brand-muted)]">{trip.usually}</dd>
              </div>
            </dl>
            <a href={site.whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp mt-auto justify-center text-sm">
              {trip.cta}
            </a>
          </article>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/things-to-do/" class="btn-green">
          Explore things to do in Burundi with a local guide
        </a>
      </div>
    </div>
  </section>

  <PriceCards preview={true} />
  <ReviewCards preview={true} />

  <section id="photos" class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Photos from Burundi"
        subtitle="A selection of images from guided trips and Burundi's landscapes."
      />
      <GalleryGrid preview={true} limit={8} />
    </div>
  </section>

  <section id="visa-arrival" class="py-16 md:py-24 bg-[var(--color-brand-bg-light)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="card">
        <h2 class="mb-4 text-2xl font-bold text-[var(--color-brand-green-dark)]">Burundi visa and arrival help</h2>
        <p class="max-w-3xl text-base leading-relaxed text-[var(--color-brand-muted)]">
          Gabriel can share practical information about arriving in Burundi and what to expect at the airport. Visa rules can change, so always check official requirements before you travel.
        </p>
        <div class="my-6 rounded-xl border border-[var(--color-brand-gold)]/40 bg-[var(--color-brand-cream)] p-4">
          <p class="font-bold text-[var(--color-brand-green-dark)]">Important:</p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-brand-muted)]">
            Your Burundi Guides can help with practical arrival questions, but official visa rules and entry requirements should always be checked with official sources before booking.
          </p>
        </div>
        <a href="/visa/" class="btn-green">Read Burundi visa and arrival info</a>
      </div>
    </div>
  </section>

  <FAQ preview={true} />
  <WhatsAppCTA />
</BaseLayout>
