---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, pageMeta } from '../data/site';

const destinations = [
  {
    icon: '🌊',
    name: 'Lake Tanganyika',
    area: 'Bujumbura',
    image: '/images/gallery/lake-tanganyika-fishermen.jpg',
    imageAlt: 'Fishermen on a wooden boat on Lake Tanganyika',
    description: 'One of the world\'s deepest lakes and a UNESCO World Heritage candidate. The lake\'s shores are just outside central Bujumbura. Swimming, boat trips, and lakeside beaches are all possible. The water is remarkably clear and the sunsets over the lake are genuinely beautiful.',
    tips: ['Best in the dry season for swimming', 'Several lakeside spots accessible from the city', 'Early morning is quietest'],
  },
  {
    icon: '🥁',
    name: 'Gishora Drum Sanctuary',
    area: 'Near Gitega',
    image: '/images/gallery/burundi-royal-drummers-parade.jpg',
    imageAlt: 'Royal drummers of Burundi carrying drums on their heads during a performance',
    description: 'Burundi\'s traditional royal drum ceremonies are a cultural experience unlike anything else in the region. The sacred drums — known as Karyenda — hold deep historical and spiritual significance. Live performances are arranged for visitors at the sanctuary in Gishora.',
    tips: ['About 2 hours from Bujumbura', 'Best combined with a full-day trip', 'Photography usually permitted'],
  },
  {
    icon: '🐊',
    name: 'Rusizi National Park',
    area: 'Near Bujumbura',
    image: '/images/gallery/wetland-water-lilies.jpg',
    imageAlt: 'Water lilies covering a wetland lagoon',
    description: 'A wetland reserve at the mouth of the Rusizi River where it flows into Lake Tanganyika. Hippos are regularly visible from the water, along with crocodiles, fish eagles, and other wetland birds. Boat trips into the park are the best way to see the wildlife.',
    tips: ['Just outside Bujumbura — can be a half-day trip', 'Boat trips available', 'Good for birdwatching'],
  },
  {
    icon: '🏔️',
    name: 'Burundi Highlands & Countryside',
    area: 'Central & Southern Burundi',
    image: '/images/gallery/burundi-tea-plantation-hills.jpg',
    imageAlt: 'Tea plantations across the green hills of the Burundi highlands',
    description: 'Burundi\'s interior is a landscape of steep green hills, tea plantations, and small rural villages. Driving through the countryside gives a very different impression of the country from the city. The views from the higher elevations are striking.',
    tips: ['Best as a multi-day trip', 'Roads can be challenging — private transport recommended', 'Tea plantations open to some visitors'],
  },
  {
    icon: '🏛️',
    name: 'Source of the Nile Area',
    area: 'Near Rutovu, Southern Burundi',
    image: '/images/gallery/source-of-the-nile-pyramid.jpg',
    imageAlt: 'Pyramid monument at the southernmost source of the Nile near Rutovu',
    description: 'Burundi claims one of the southernmost sources of the Nile River — a spring in the hills near the town of Rutovu. A pyramid monument marks the site. It is a rarely visited but genuinely interesting landmark for travellers interested in geography and exploration history.',
    tips: ['A long day trip or overnighter from Bujumbura', 'Best with a local guide who knows the area', 'Combine with countryside driving'],
  },
  {
    icon: '🏙️',
    name: 'Bujumbura City',
    area: 'Bujumbura',
    image: '/images/gallery/bujumbura-viewpoint-group.jpg',
    imageAlt: 'Travellers with their local guide overlooking Bujumbura',
    description: 'The capital is a working city on the edge of Lake Tanganyika. It has busy markets, lively streets, good local restaurants, and a mix of colonial-era and modern buildings. Walking the city with a local guide brings it to life in a way that independent wandering does not.',
    tips: ['Central Market is worth visiting', 'Lakeside area has cafes and restaurants', 'Safer to walk key areas with a local guide'],
  },
  {
    icon: '🛒',
    name: 'Local Markets',
    area: 'Bujumbura',
    image: '/images/gallery/bujumbura-market-pineapples.jpg',
    imageAlt: 'Fresh pineapples for sale at a local market stall',
    description: 'Bujumbura\'s central market is a dense, energetic place selling fresh produce, household goods, clothes, and local crafts. Having Gabriel with you makes the experience much richer — he can introduce you to vendors, explain what you\'re seeing, and help you find things worth buying.',
    tips: ['Central Market is the main one', 'Morning is the busiest', 'Best with a guide who knows the layout'],
  },
  {
    icon: '🌿',
    name: 'Cultural Visits & Community Experiences',
    area: 'Various locations',
    image: '/images/gallery/village-visit-children.jpg',
    imageAlt: 'Traveller meeting children during a village visit',
    description: 'Depending on your interests, Gabriel can arrange visits to local communities, craft workshops, and cultural sites around Bujumbura. These experiences are not on standard tourist trails and require a trusted local contact to arrange respectfully.',
    tips: ['Arrange in advance', 'Be flexible — these visits depend on local availability', 'Bring a respectful and open attitude'],
  },
];

const regionalTours = [
  {
    icon: '🦍',
    name: 'Gorilla Trekking',
    area: 'Rwanda, Uganda & DRC',
    image: '/images/gallery/mountain-gorilla-mother-baby.jpg',
    imageAlt: 'Mountain gorilla mother with her baby seen on a gorilla trekking trip',
    description: 'Trek to see mountain gorillas in the forests of Rwanda or Uganda, with DRC sometimes possible depending on current conditions. Gabriel arranges permits, transport and accommodation, and travels with you. Standing a few metres from a gorilla family is a genuinely unforgettable experience.',
    tips: ['Permits must be booked well in advance', 'A reasonable level of fitness helps', 'Combine with your Burundi trip into one route'],
  },
  {
    icon: '🐘',
    name: 'Wildlife Safaris',
    area: 'Uganda',
    image: '/images/gallery/elephant-crossing-safari-road.jpg',
    imageAlt: 'Elephant crossing a dirt road on an East African safari',
    description: 'Elephants, hippos, buffalo, antelope and rich birdlife on safari in Uganda\'s national parks, including Queen Elizabeth National Park. Game drives and boat safaris can be combined with a gorilla trek for a longer overland route starting or ending in Burundi.',
    tips: ['Best as a 2–3 day extension', 'Game drives are best early morning', 'Boat safaris offer the closest hippo sightings'],
  },
  {
    icon: '🦏',
    name: 'Rhino Trekking on Foot',
    area: 'Ziwa Rhino Sanctuary, Uganda',
    image: '/images/gallery/rhino-trek-guest.jpg',
    imageAlt: 'Traveller on a guided rhino trekking walk',
    description: 'Walk with rangers to within safe viewing distance of wild white rhinos — on foot, not from a vehicle. The sanctuary protects Uganda\'s only wild rhino population and the walking experience feels completely different from a normal game drive.',
    tips: ['Guided by armed rangers at all times', 'Easy walking — suitable for most travellers', 'Often combined with a wider Uganda route'],
  },
  {
    icon: '🌉',
    name: 'Rainforest Canopy Walkway',
    area: 'Nyungwe Forest, Rwanda',
    image: '/images/gallery/rainforest-canopy-bridge.jpg',
    imageAlt: 'Canopy walkway suspended above the rainforest',
    description: 'Cross a suspension walkway high above the rainforest canopy in Nyungwe Forest, one of Africa\'s oldest mountain rainforests. Nyungwe sits close to the Burundi border, so it fits naturally into a combined Burundi and Rwanda itinerary.',
    tips: ['A head for heights helps', 'Chimpanzee and primate tracking also possible', 'Easily combined with the Burundi highlands'],
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Things to Do in Burundi',
  description: pageMeta.thingsToDo.description,
  url: `${site.siteUrl}/things-to-do/`,
  itemListElement: [...destinations, ...regionalTours].map((d, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: d.name,
    description: d.description,
  })),
};
---

<BaseLayout
  title={pageMeta.thingsToDo.title}
  description={pageMeta.thingsToDo.description}
  canonical={`${site.siteUrl}/things-to-do/`}
  structuredData={structuredData}
>
  <!-- Page header -->
  <div class="bg-[var(--color-brand-green-dark)] text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Experiences</p>
        <h1 class="display-title text-balance mb-5 text-5xl md:text-6xl">Things to Do in Burundi</h1>
        <p class="text-xl leading-9 text-white/80">
          A guide to the most rewarding Burundi experiences — from Lake Tanganyika and the Gishora Drum Sanctuary to the highlands, cultural visits, and local markets. Plus gorilla treks and safaris in Rwanda, Uganda and DRC.
        </p>
      </div>
    </div>
  </div>

  <section class="py-16 bg-[var(--color-brand-cream)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {destinations.map((dest) => (
          <div class="card flex flex-col gap-5">
            <img
              src={dest.image}
              alt={dest.imageAlt}
              class="aspect-[16/9] w-full rounded-xl object-cover"
              loading="lazy"
              decoding="async"
              width="640"
              height="360"
            />
            <div class="flex gap-5">
            <div class="text-4xl flex-shrink-0">{dest.icon}</div>
            <div>
              <div class="flex items-baseline gap-2 mb-1">
                <h2 class="text-xl font-bold text-[var(--color-brand-green-dark)]">{dest.name}</h2>
                <span class="text-xs text-[var(--color-brand-muted)] bg-[var(--color-brand-bg-light)] px-2 py-0.5 rounded-full">{dest.area}</span>
              </div>
              <p class="mb-3 text-base leading-8 text-[var(--color-brand-muted)]">{dest.description}</p>
              <div class="space-y-1">
                {dest.tips.map((tip) => (
                  <div class="flex items-start gap-2 text-sm leading-6 text-[var(--color-brand-muted)]">
                    <svg class="w-3 h-3 text-[var(--color-brand-green)] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    {tip}
                  </div>
                ))}
              </div>
            </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Regional tours beyond Burundi -->
      <div class="mt-20">
        <SectionHeading
          title="Tours beyond Burundi"
          subtitle="Burundi sits next to Rwanda, DRC and Uganda — and the guides regularly run cross-border trips combining Burundi with the region's biggest wildlife experiences."
        />
        <figure class="mx-auto mb-10 max-w-2xl text-center">
          <blockquote class="text-lg italic leading-8 text-[var(--color-brand-green-dark)]">
            "We have photos taken during the tours we made here in Burundi, Rwanda, DRC and Uganda."
          </blockquote>
          <figcaption class="mt-2 text-sm font-semibold text-[var(--color-brand-muted)]">
            — Gabriel, lead guide
          </figcaption>
        </figure>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {regionalTours.map((tour) => (
            <div class="card flex flex-col gap-5">
              <img
                src={tour.image}
                alt={tour.imageAlt}
                class="aspect-[16/9] w-full rounded-xl object-cover"
                loading="lazy"
                decoding="async"
                width="640"
                height="360"
              />
              <div class="flex gap-5">
              <div class="text-4xl flex-shrink-0">{tour.icon}</div>
              <div>
                <div class="flex items-baseline gap-2 mb-1">
                  <h2 class="text-xl font-bold text-[var(--color-brand-green-dark)]">{tour.name}</h2>
                  <span class="text-xs text-[var(--color-brand-muted)] bg-[var(--color-brand-bg-light)] px-2 py-0.5 rounded-full">{tour.area}</span>
                </div>
                <p class="mb-3 text-base leading-8 text-[var(--color-brand-muted)]">{tour.description}</p>
                <div class="space-y-1">
                  {tour.tips.map((tip) => (
                    <div class="flex items-start gap-2 text-sm leading-6 text-[var(--color-brand-muted)]">
                      <svg class="w-3 h-3 text-[var(--color-brand-green)] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      {tip}
                    </div>
                  ))}
                </div>
              </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA card -->
      <div class="mt-12 card bg-[var(--color-brand-green-dark)] text-white text-center max-w-2xl mx-auto">
        <h2 class="text-xl font-bold mb-3">Want help planning your Burundi itinerary?</h2>
        <p class="mb-4 text-base leading-7 text-white/75">
          Gabriel can help you build a realistic day-by-day plan based on your travel dates, group size, and interests. Tell him what you want to see and he will suggest what is practical.
        </p>
        <a href="/contact/" class="btn-primary inline-flex">Plan my Burundi trip with a local guide</a>
      </div>

      <!-- Internal links -->
      <div class="mt-10 flex flex-wrap justify-center gap-4 text-sm">
        <a href="/services/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          View private guiding services in Burundi
        </a>
        <span class="text-[var(--color-brand-border)]">·</span>
        <a href="/prices/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          Ask for a Burundi guide price quote
        </a>
        <span class="text-[var(--color-brand-border)]">·</span>
        <a href="/contact/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          Contact Gabriel on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <WhatsAppCTA
    heading="See Burundi with a local guide"
    subtext="Message Gabriel to plan your itinerary. He knows which places are worth visiting and how to get there."
    variant="cream"
  />
</BaseLayout>
