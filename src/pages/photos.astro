---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { galleryImages } from '../data/gallery';
import { site, pageMeta } from '../data/site';
---

<BaseLayout
  title={pageMeta.photos.title}
  description={pageMeta.photos.description}
  canonical={`${site.siteUrl}/photos/`}
>
  <!-- Page header -->
  <div class="bg-[var(--color-brand-green-dark)] text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-[var(--color-brand-gold)] font-semibold text-sm uppercase tracking-wider mb-3">Gallery</p>
        <h1 class="text-4xl font-bold mb-4">Burundi Travel Photos</h1>
        <p class="text-white/80 text-lg">
          Images from guided trips, Burundi's landscapes, Lake Tanganyika, cultural visits, and daily life in Bujumbura.
        </p>
      </div>
    </div>
  </div>

  <section class="py-16 bg-[var(--color-brand-cream)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <GalleryGrid preview={false} limit={galleryImages.length} />

      <!-- Internal links -->
      <div class="mt-12 flex flex-wrap justify-center gap-4 text-sm">
        <a href="/services/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          View private guiding services in Burundi
        </a>
        <span class="text-gray-300">·</span>
        <a href="/contact/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          Plan your own Burundi trip with Gabriel
        </a>
      </div>
    </div>
  </section>

  <WhatsAppCTA
    heading="Want to see Burundi for yourself?"
    subtext="Message Gabriel on WhatsApp to plan your trip."
    variant="green"
  />
</BaseLayout>
