---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCards from '../components/ReviewCards.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { reviews } from '../data/reviews';
---

<BaseLayout
  title="Reviews | Your Burundi Guides"
  description="Read what visitors say about travelling in Burundi with Gabriel and Ernest — private guides based in Bujumbura."
  canonical="https://www.yourburundiguides.com/reviews/"
>
  <!-- Page header -->
  <div class="bg-[var(--color-brand-green-dark)] text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-[var(--color-brand-gold)] font-semibold text-sm uppercase tracking-wider mb-3">Visitor Reviews</p>
        <h1 class="text-4xl font-bold mb-4">What Visitors Say</h1>
        <p class="text-white/80 text-lg">
          Experiences from travellers who have visited Burundi with Gabriel and Ernest.
        </p>
      </div>
    </div>
  </div>

  <ReviewCards preview={false} />

  <!-- Review photos section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-[var(--color-brand-green-dark)] mb-8 text-center">Photos from visits</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {reviews.filter(r => r.image).map((review) => (
          <div class="rounded-lg overflow-hidden aspect-square">
            <img
              src={review.image}
              alt={review.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              loading="lazy"
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <WhatsAppCTA
    heading="Planning a Burundi trip?"
    subtext="Join the travellers who have experienced Burundi with a local guide. Message Gabriel on WhatsApp."
    variant="green"
  />
</BaseLayout>
