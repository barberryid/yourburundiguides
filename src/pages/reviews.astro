---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCards from '../components/ReviewCards.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { reviews } from '../data/reviews';
import { site, pageMeta } from '../data/site';
---

<BaseLayout
  title={pageMeta.reviews.title}
  description={pageMeta.reviews.description}
  canonical={`${site.siteUrl}/reviews/`}
>
  <!-- Page header -->
  <div class="bg-[var(--color-brand-green-dark)] text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-[var(--color-brand-gold)] font-semibold text-sm uppercase tracking-wider mb-3">Visitor Reviews</p>
        <h1 class="text-4xl font-bold mb-4">Reviews from Travellers</h1>
        <p class="text-white/80 text-lg">
          Experiences from travellers who have visited Burundi with Gabriel and Ernest.
        </p>
      </div>
    </div>
  </div>

  <ReviewCards preview={false} />

  <!-- Review photos section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-[var(--color-brand-green-dark)] mb-8 text-center">Photos from visits</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {reviews.filter(r => r.image).map((review) => (
          <div class="rounded-lg overflow-hidden aspect-square">
            <img
              src={review.image}
              alt={review.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              loading="lazy"
              width="400"
              height="400"
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        ))}
      </div>

      <!-- Internal links -->
      <div class="mt-10 flex flex-wrap justify-center gap-4 text-sm">
        <a href="/services/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          View private guiding services in Burundi
        </a>
        <span class="text-gray-300">·</span>
        <a href="/contact/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          Contact Gabriel on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <WhatsAppCTA
    heading="Planning a Burundi trip?"
    subtext="Join the travellers who have experienced Burundi with a local guide. Message Gabriel on WhatsApp."
    variant="green"
  />
</BaseLayout>
