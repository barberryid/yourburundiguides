---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCards from '../components/ReviewCards.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { reviews } from '../data/reviews';
import { site, pageMeta } from '../data/site';

const tripadvisorUrl = 'https://www.tripadvisor.com/Attraction_Review-g293771-d32861065-Reviews-Burundi_Guides-Bujumbura_Bujumbura_Mairie_Province.html';
---

<BaseLayout
  title={pageMeta.reviews.title}
  description={pageMeta.reviews.description}
  canonical={`${site.siteUrl}/reviews/`}
>
  <!-- Page header -->
  <div class="bg-[var(--color-brand-green-dark)] text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Visitor Reviews</p>
        <h1 class="display-title text-balance mb-5 text-5xl md:text-6xl">Reviews from Travellers</h1>
        <p class="text-xl leading-9 text-white/80">
          Experiences from travellers who have visited Burundi with Gabriel and Ernest.
        </p>
      </div>
    </div>
  </div>

  <ReviewCards preview={false} />

  <section class="py-16 bg-[var(--color-brand-cream)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <article class="card grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="eyebrow mb-3 text-[var(--color-brand-green)]">
            Tripadvisor reviews
          </p>
          <h2 class="display-title mb-3 text-3xl text-[var(--color-brand-green-dark)]">
            See Burundi Guides on Tripadvisor
          </h2>
          <p class="max-w-3xl text-base leading-8 text-[var(--color-brand-muted)]">
            Visit the Tripadvisor page for Burundi Guides to see more traveller feedback and details about guided experiences in Bujumbura and around Burundi.
          </p>
        </div>
        <a
          href={tripadvisorUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-green justify-center whitespace-nowrap"
          aria-label="Open the Burundi Guides Tripadvisor page in a new tab"
        >
          View Tripadvisor page
        </a>
      </article>
    </div>
  </section>

  <!-- Review photos section -->
  <section class="py-16 bg-[var(--color-brand-cream)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="display-title mb-8 text-center text-4xl text-[var(--color-brand-green-dark)]">Photos from visits</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {reviews.filter(r => r.image).map((review) => (
          <div class="rounded-lg overflow-hidden aspect-square">
            <img
              src={review.image}
              alt={review.alt}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              loading="lazy"
              width="400"
              height="400"
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        ))}
      </div>

      <!-- Internal links -->
      <div class="mt-10 flex flex-wrap justify-center gap-4 text-sm">
        <a href="/services/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          View private guiding services in Burundi
        </a>
        <span class="text-[var(--color-brand-border)]">·</span>
        <a href="/contact/" class="text-[var(--color-brand-green)] underline hover:text-[var(--color-brand-green-dark)]">
          Contact Gabriel on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <WhatsAppCTA
    heading="Planning a Burundi trip?"
    subtext="Join the travellers who have experienced Burundi with a local guide. Message Gabriel on WhatsApp."
    variant="green"
  />
</BaseLayout>
