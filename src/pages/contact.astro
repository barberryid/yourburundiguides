---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, pageMeta } from '../data/site';
---

<BaseLayout
  title={pageMeta.contact.title}
  description={pageMeta.contact.description}
  canonical={`${site.siteUrl}/contact/`}
>
  <!-- Page header -->
  <div class="bg-[var(--color-brand-green-dark)] text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Get in Touch</p>
        <h1 class="display-title text-balance mb-5 text-5xl md:text-6xl">Contact Your Burundi Guides</h1>
        <p class="text-xl leading-9 text-white/80">
          The quickest way to reach Gabriel is WhatsApp. Send your dates and plans and he will reply with options and a clear price.
        </p>
      </div>
    </div>
  </div>

  <div class="py-16 bg-[var(--color-brand-cream)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- WhatsApp -->
        <div class="card border-2 border-[var(--color-brand-green)]/20">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-green-500 flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-label="WhatsApp">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-bold text-[var(--color-brand-green-dark)]">WhatsApp</h2>
              <p class="text-base leading-7 text-[var(--color-brand-muted)]">Fastest response</p>
            </div>
          </div>
          <p class="mb-4 text-base leading-7 text-[var(--color-brand-muted)]">
            Send Gabriel a WhatsApp message with your travel dates and plans. He typically replies within a few hours.
          </p>
          <p class="font-semibold text-[var(--color-brand-charcoal)] mb-4">{site.whatsapp}</p>
          <a
            href={site.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full justify-center"
          >
            Open WhatsApp chat with Gabriel
          </a>
        </div>

        <!-- Email -->
        <div class="card border-2 border-gray-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-[var(--color-brand-green)] flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-label="Email">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-bold text-[var(--color-brand-green-dark)]">Email</h2>
              <p class="text-base leading-7 text-[var(--color-brand-muted)]">For longer messages</p>
            </div>
          </div>
          <p class="mb-4 text-base leading-7 text-[var(--color-brand-muted)]">
            Email is also fine for detailed enquiries. Response times may be slightly slower than WhatsApp.
          </p>
          <p class="font-semibold text-[var(--color-brand-charcoal)] mb-4">{site.email}</p>
          <a
            href={`mailto:${site.email}`}
            class="btn-green w-full justify-center"
          >
            Send an email
          </a>
        </div>
      </div>

      <!-- What to include -->
      <div class="card mt-8">
        <h2 class="text-xl font-bold text-[var(--color-brand-green-dark)] mb-4">What to include in your message</h2>
        <p class="mb-4 text-base leading-7 text-[var(--color-brand-muted)]">
          The more detail you include, the faster Gabriel can give you a useful reply and a clear quote.
        </p>
        <ul class="space-y-2">
          {[
            'Your travel dates (when you arrive and leave)',
            'Number of people in your group',
            'Your arrival city and airport',
            'What you are most interested in seeing or doing',
            'Whether you need airport pickup',
            'Whether you need private transport',
            'Your preferred language (English or French)',
            'Any specific requests or questions',
          ].map((item) => (
            <li class="flex items-start gap-2 text-base leading-7 text-[var(--color-brand-charcoal)]">
              <svg class="w-4 h-4 text-[var(--color-brand-green)] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Sample message -->
      <div class="card mt-6 bg-[var(--color-brand-bg-light)]">
        <h3 class="font-semibold text-[var(--color-brand-green-dark)] mb-2 text-sm uppercase tracking-wider">Sample message — copy and send</h3>
        <p class="font-mono text-sm text-[var(--color-brand-charcoal)] leading-relaxed bg-white rounded-lg p-4 border border-gray-100">
          Hello Gabriel, I am planning a trip to Burundi. My dates are [dates]. We are [number] people. I am interested in [places/services]. Can you please help me with a guide, transport, and a quote?
        </p>
        <a
          href={`${site.whatsappLink}?text=Hello%20Gabriel%2C%20I%20am%20planning%20a%20trip%20to%20Burundi.%20My%20dates%20are%20%5Bdates%5D.%20We%20are%20%5Bnumber%5D%20people.%20I%20am%20interested%20in%20%5Bplaces%2Fservices%5D.%20Can%20you%20please%20help%20me%20with%20a%20guide%2C%20transport%2C%20and%20a%20quote%3F`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-4 inline-flex"
        >
          Send this on WhatsApp
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
